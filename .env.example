# ==============================================================================
# Dotta Environment Configuration
# ==============================================================================

# Primary Default Model Provider (Meta Muse / Modal)
DEFAULT_MODEL=muse-spark-open
META_MUSE_API_KEY=your_meta_muse_api_key_here
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_MODEL=muse-spark-open

# Your deployed model endpoint (OpenAI-compatible, ends with /v1)
MODAL_MUSE_SPARK_URL=https://your-model-endpoint.example.com/v1
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_API_KEY=

# Meta Model API & Inference Partners
MODEL_API_KEY=
MUSE_API_KEY=
FIREWORKS_API_KEY=
TOGETHER_API_KEY=

# Server & Network Configuration
PORT=3001
NODE_ENV=production
PUBLIC_DOMAIN=yourdomain.com

# Long random string used to sign sessions (e.g. output of: openssl rand -hex 32)
SESSION_SECRET=

# Optional: provision an admin / reviewer account on first start.
# Passwords must be at least 12 characters. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# Supabase & Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=

# Sandboxing & Tool Configuration
DOTTA_SANDBOX_DISTRO=dotta-sandbox
AGENT_AUDIT_LOG=data/audit.jsonl
AGENT_DATA_DIR=data/threads
CHROME_BIN=
