# ==============================================================================
# Dotta Environment Configuration
# 100% Bring Your Own Key (BYOK) Architecture:
# The server holds NO model keys. All users configure their personal Meta API key
# (or personal Modal vLLM container URL & tokens) in Settings -> API Keys & Compute.
# ==============================================================================

# Primary Default Model Provider
DEFAULT_MODEL=muse-spark-open
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_MODEL=muse-spark-open

# Optional: Headless CLI Testing Endpoint (OpenAI-compatible vLLM)
# Note: Web users configure their personal Modal container URL directly in Settings -> API Keys & Compute.
MODAL_MUSE_SPARK_URL=https://your-model-endpoint.example.com/v1

# Server & Network Configuration
PORT=3001
NODE_ENV=production
PUBLIC_DOMAIN=yourdomain.com

# Long random string used to sign sessions (e.g. output of: openssl rand -hex 32)
SESSION_SECRET=

# Optional: provision an admin / reviewer account on first start.
# Passwords must be at least 12 characters. Leave blank to skip.
ADMIN_EMAIL=
ADMIN_PASSWORD=
REVIEWER_EMAIL=
REVIEWER_PASSWORD=

# Supabase & Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
