# ==============================================================================
# Omni Agent Environment Configuration
# ==============================================================================

# Primary Default Model Provider (Meta Muse)
DEFAULT_MODEL=meta-muse-spark
META_MUSE_API_KEY=your_meta_muse_api_key_here
META_MUSE_BASE_URL=https://api.meta.ai/v1
META_MUSE_MODEL=muse-spark-1.3

# Alternative Model Providers (Optional Fallbacks)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# Server & Network Configuration
PORT=3001
NODE_ENV=production
PUBLIC_DOMAIN=yourdomain.com

# Supabase & Database Configuration (Optional)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
DATABASE_URL=

# Sandboxing & Tool Configuration
OMNI_SANDBOX_DISTRO=omni-agent-sandbox
AGENT_AUDIT_LOG=data/audit.jsonl
AGENT_DATA_DIR=data/threads
CHROME_BIN=
